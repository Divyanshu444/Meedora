# ─── Shopify (Required) ───
# Your Shopify store domain (e.g. your-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=

# Shopify Storefront API access token (starts with shpat_ or similar)
# Generate via Shopify Admin → Settings → Apps → Develop apps → Storefront API
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ─── Analytics (Optional) ───
# Meta (Facebook) Pixel ID for ad retargeting & conversion tracking
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ─── Contact & Support (Optional) ───
# WhatsApp Business Number with country code, no + or spaces (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=
